@@ -427,6 +473,7 @@ int sf32lb_adc_init(const char *devpath)
         }
 
         ctx->initialized = 1;
+        strlcpy(ctx->devpath, devpath, sizeof(ctx->devpath));
     }
 
     syslog(LOG_INFO, "ADC %s init done, ret=%d\n", devpath, ret);
@@ -435,3 +482,8 @@ int sf32lb_adc_init(const char *devpath)
 
     return ret;
 }
+
+int sf32lb_adc_init(const char *devpath)
+{
+    return sf32lb_adc_channel_init(devpath, ADC_CHAN_VBAT);
+}
