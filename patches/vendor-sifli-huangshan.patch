 /****************************************************************************
@@ -62,7 +63,13 @@ static void adc_read_work(struct adc_dev_s *dev);
  * Private Data
  ****************************************************************************/
 
-static struct adc_info_s g_adc_info;
+/* GPADC1 is a single hardware peripheral, but NuttX clients need distinct
+ * upper-half devices for the fixed VBAT path and the external PA28 input.
+ * Conversions remain serialized by g_lock below; each device simply selects
+ * its own channel before triggering a conversion. */
+#define SF32LB_ADC_DEVICE_COUNT 2
+
+static struct adc_info_s g_adc_info[SF32LB_ADC_DEVICE_COUNT];
 
 static const struct adc_ops_s g_adcops =
 {
@@ -74,10 +81,16 @@ static const struct adc_ops_s g_adcops =
