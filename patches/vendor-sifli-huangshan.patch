  ****************************************************************************/
 
-int sf32lb_adc_init(const char *devpath)
+int sf32lb_adc_channel_init(const char *devpath, uint8_t channel)
 {
     int ret = OK;
+    int index = -1;
+    int free_index = -1;
+    int i;
     struct adc_dev_s *dev;
     struct adc_info_s *ctx;
     ADC_HandleTypeDef *adc_handle;
@@ -398,7 +414,37 @@ int sf32lb_adc_init(const char *devpath)
     return ret;
 #endif
 
