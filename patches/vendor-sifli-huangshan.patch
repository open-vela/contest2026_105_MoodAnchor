+    if (devpath == NULL || channel > ADC_CHAN_7)
+    {
+        return -EINVAL;
+    }
+
+    for (i = 0; i < SF32LB_ADC_DEVICE_COUNT; i++)
+    {
+        if (g_adc_info[i].initialized != 0 &&
+            strcmp(g_adc_info[i].devpath, devpath) == 0)
+        {
+            if (g_adc_info[i].channel != channel)
+            {
+                return -EEXIST;
+            }
+
+            return OK;
+        }
+
+        if (g_adc_info[i].initialized == 0 && free_index < 0)
+        {
+            free_index = i;
+        }
+    }
+
+    if (free_index < 0)
+    {
+        return -ENOMEM;
+    }
+
+    index = free_index;
+    dev = &g_adc_chan_dev[index];
     ctx = (struct adc_info_s *)dev->ad_priv;
     adc_handle = (ADC_HandleTypeDef *)&ctx->adc_handle;
 
@@ -407,7 +453,7 @@ int sf32lb_adc_init(const char *devpath)
