-static struct adc_dev_s g_adc_chan_dev =
+static struct adc_dev_s g_adc_chan_dev[SF32LB_ADC_DEVICE_COUNT] =
 {
-    .ad_ops  = &g_adcops,
-    .ad_priv = &g_adc_info,
+    {
+        .ad_ops  = &g_adcops,
+        .ad_priv = &g_adc_info[0],
+    },
+    {
+        .ad_ops  = &g_adcops,
+        .ad_priv = &g_adc_info[1],
+    },
 };
 
 static mutex_t g_lock = NXMUTEX_INITIALIZER;
@@ -385,9 +398,12 @@ static void sf32lb_adc_default_config(ADC_HandleTypeDef *cfg)
