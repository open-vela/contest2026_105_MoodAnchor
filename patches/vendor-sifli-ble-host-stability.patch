+ * the NuttX heap.  Otherwise BLE traffic overwrites live heap objects. */
+
+#define SRAM_END    HCPU2LCPU_MB_CH2_BUF_START_ADDR
 
 /* PSRAM memory configuration for SF32LB52 (MPI1 SBUS) */
 
