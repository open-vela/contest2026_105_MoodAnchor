+++ b/chips/sf32lb52/sifli_allocateheap.c
@@ -41,7 +41,11 @@ extern void BSP_Board_PreInit(void);
 
 #define SRAM_START  0x20000000
 #define SRAM_SIZE   0x00080000    /* 512 KB */
-#define SRAM_END    (SRAM_START + SRAM_SIZE)
+/* The final 1 KiB of HPSYS SRAM is reserved for the two HCPU-to-LCPU
