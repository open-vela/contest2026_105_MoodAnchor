diff --git a/chips/sf32lb52/sf32lb52_bth4.c b/chips/sf32lb52/sf32lb52_bth4.c
index 49796cc..976e2f2 100644
--- a/chips/sf32lb52/sf32lb52_bth4.c
+++ b/chips/sf32lb52/sf32lb52_bth4.c
@@ -167,7 +167,7 @@ static void sf32lb52_bt_close(struct bt_driver_s *drv);
 static int sf32lb52_bt_recv_cb(uint8_t *data, uint16_t len);
 static int sf32lb52_bt_ensure_controller_enabled(uint16_t opcode);
 
-#ifdef CONFIG_BT
+#if defined(CONFIG_BT) && defined(CONFIG_ZBLUE)
 extern void z_sys_init(void);
 
 static bool g_sf32lb52_zblue_inited;
@@ -651,7 +651,13 @@ static int sf32lb52_bt_open(struct bt_driver_s *drv)
       return ret;
     }
 
-  return OK;
+  /* Boot the LCPU before hci_initialize() starts its first 2.5 second
+   * synchronous-command timeout.  A cold boot takes about 2.5 seconds on
+   * this board; doing it lazily from send() consumes the whole Reset budget
+   * and forces bt_netdev_register() down an unsafe retry path.  RX remains
+   * suppressed until the first host command, so boot chatter is discarded. */
+
+  return sf32lb52_bt_controller_enable();
 }
 
 static void sf32lb52_bt_close(struct bt_driver_s *drv)
@@ -689,3 +695,15 @@ int sf32lb52_bt_initialize(void)
 
   return OK;
 }
+
+/* Return the vendor HCI driver so the host stack can be bound directly to
+ * the controller (the standard openvela BTH4 architecture): the driver
+ * already frames H:4 on send and hands complete HCI packets to
+ * bt_netdev_receive() on receive.  Going through the /dev/ttyHCI0
+ * character device and re-implementing H:4 on top of it is not needed.
+ */
+
+struct bt_driver_s *sf32lb52_bt_get_driver(void)
+{
+  return &g_sf32lb52_bt_priv.drv;
+}
diff --git a/chips/sf32lb52/sifli_allocateheap.c b/chips/sf32lb52/sifli_allocateheap.c
